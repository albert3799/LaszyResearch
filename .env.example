# Copy this to .env and fill in your values
# DO NOT commit .env to git

# OpenAI API (required)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional model overrides
OPENAI_STRONG_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
REPORT_FINDER_MODEL=gpt-5.4-nano
REPORT_ANALYST_MODEL=gpt-5.4

# Serper — Google search for EMEA annual/interim report PDFs
SERPER_API_KEY=serper_your-key-here

# UK Companies House — optional fallback for UK annual accounts
COMPANIES_HOUSE_API_KEY=companies_house_your-key-here

# Apify — LinkedIn profile scraping (required for LinkedIn agent)
APIFY_TOKEN=apify_api_your-token-here

# TheirStack — hiring signal detection (required for Hiring agent)
THEIRSTACK_API_KEY=ts_your-key-here

# Supabase — database persistence (required for Output agent)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci-your-service-role-key-here
