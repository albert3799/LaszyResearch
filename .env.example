# Copy this to .env and fill in your values.
# DO NOT commit .env to git (already in .gitignore).

# ─────────────────────────────────────────────────────────────
# Claude LLM access
# ─────────────────────────────────────────────────────────────
# You have THREE choices — uncomment the block that matches your setup.

# (A) Anthropic direct
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# (B) Azure Marketplace SaaS for Anthropic — same as direct Anthropic
#     (Anthropic-issued key, billing routed through your Azure subscription).
#     No code changes needed beyond setting the key.
# ANTHROPIC_API_KEY=sk-ant-your-marketplace-key-here

# (C) Azure AI Foundry deployment — Microsoft-hosted Claude in your tenant.
#     Grab BASE_URL + key from the Foundry deployment page.
#     Model IDs in agents/*.py may need to match the Foundry catalog
#     (e.g., "claude-sonnet-4-5" instead of dated Anthropic IDs).
# ANTHROPIC_API_KEY=your-foundry-deployment-key
# ANTHROPIC_BASE_URL=https://your-foundry-deployment.services.ai.azure.com/anthropic

# ─────────────────────────────────────────────────────────────
# Apify — LinkedIn profile scraping (required for LinkedIn agent)
# ─────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your-token-here

# ─────────────────────────────────────────────────────────────
# TheirStack — hiring signal detection (required for Hiring agent)
# ─────────────────────────────────────────────────────────────
THEIRSTACK_API_KEY=ts_your-key-here

# ─────────────────────────────────────────────────────────────
# Supabase — database persistence (required for Output agent)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci-your-service-role-key-here
