# Copy this to .env and fill in your values.
# DO NOT commit .env to git (already in .gitignore).

# ─────────────────────────────────────────────────────────────
# Azure OpenAI — LLM access (required)
# ─────────────────────────────────────────────────────────────
# The pipeline talks to Azure OpenAI via the v1 (OpenAI-compatible) endpoint.
# Get these from Azure AI Foundry → your project → Deployments.

# Resource base URL — ends in /openai/v1 (NOT a per-deployment URL).
# Example: https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1

# Resource API key (shared across all deployments in the same Azure OpenAI resource)
AZURE_OPENAI_API_KEY=your-key-here

# Deployment names — set these to the names you gave your deployments in Foundry.
# Use the same value for both if you only have one deployment.
REASONING_MODEL_DEPLOYMENT=gpt-5         # used by web_research, financials, scoring
EXTRACTION_MODEL_DEPLOYMENT=gpt-5        # used by linkedin, hiring, output

# ─────────────────────────────────────────────────────────────
# Apify — LinkedIn profile scraping (required for LinkedIn agent)
# ─────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your-token-here

# ─────────────────────────────────────────────────────────────
# TheirStack — hiring signal detection (required for Hiring agent)
# ─────────────────────────────────────────────────────────────
THEIRSTACK_API_KEY=ts_your-key-here

# ─────────────────────────────────────────────────────────────
# Supabase — database persistence (required for Output agent)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-secret-key-here
